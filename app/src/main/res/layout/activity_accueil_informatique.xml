<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPurple"
    tools:context=".Accueil_informatique">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="100dp"
        android:layout_marginLeft="130dp"
        android:src="@drawable/informatique"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Informatique"
        android:textStyle="bold"
        android:textSize="25dp"
        android:textColor="#FF9800"
        android:layout_marginTop="20dp"
       android:layout_gravity="center"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consignes :"
        android:textSize="25dp"
        android:textColor="@color/colorWhite"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="50dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" Le test comporte 10 questions."
        android:textSize="20dp"
        android:textColor="@color/colorWhite"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="50dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Une seule bonne réponse par question."
        android:textSize="20dp"
        android:textColor="@color/colorWhite"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="50dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Le chronométre démarre lorsque vous cliquez sur Démarrer le quiz."
        android:textSize="20dp"
        android:textColor="@color/colorWhite"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="50dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="30dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/retour"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_row="1"
            android:layout_column="0"
            app:cardCornerRadius="30dp"

            app:cardElevation="12dp"
            android:layout_margin="15dp"
            app:cardBackgroundColor="#FFF5E0">
            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Retour"
                android:textColor="#FF9800"
                android:textSize="20dp"/>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="      "
            />

        <androidx.cardview.widget.CardView
            android:id="@+id/demarrer"
            android:layout_width="150dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_row="1"
            android:layout_column="1"
            app:cardCornerRadius="30dp"
            app:cardElevation="12dp"
            android:layout_margin="12dp"
            app:cardBackgroundColor="#FF9800">




            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Démarrer"
                android:textColor="@color/white"
                android:textSize="20dp" />





        </androidx.cardview.widget.CardView>


</LinearLayout>


    </LinearLayout>